	.Z80
START:	RST	30H
	DB	8
	DW	7EH	;CLS
TLOOP3:	LD	HL,0
	RST	30H
	DB	8
	DW	0DBH	;SETXY
	LD	BC,800H
TLOOP2:	CALL	MATCON
	LD	HL,BUF
	PUSH	BC
	LD	B,8
TLOOP1:	RLCA
	LD	(HL),"0"
	JR	NC,SET0
	LD	(HL),"1"
SET0:	INC	HL
	DJNZ	TLOOP1
	LD	DE,BUF
	LD	C,9
	CALL	5
	POP	BC
	INC	C
	DJNZ	TLOOP2
	RST	30H
	DB	8
	DW	0FCH	;BREAK
	JR	NC,TLOOP3
	RST	30H
	DB	8
	DW	7EH	;CLS
	RST	0
;
MATCON:	PUSH	BC
	LD	A,C
	OR	A
	LD	A,0FEH
	JR	Z,MATC0
MATC1:	RLCA
	DEC	C
	JR	NZ,MATC1
MATC0:	LD	BC,0F9D0H
	OUT	(C),A
	INC	C
	IN	A,(C)
	POP	BC
	RET
;
BUF:	DB	"11111111",13,10,36
	END	START
