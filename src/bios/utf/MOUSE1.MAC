	.Z80
MAXX	EQU	100
SCALE	EQU	4
;
START:	RST	30H
	DB	8
	DW	0135H
	RST	30H
	DB	8
	DW	0138H
	RST	30H
	DB	8
	DW	007EH
	LD	HL,SCALE*101H
	LD	(0FEF1H),HL
	LD	HL,MAXX
	LD	(0FEEFH),HL
	LD	(0FEEDH),HL
	LD	HL,0025H
	LD	(OUT_BUF+8),HL
LOOP:	LD	HL,(0FEEBH)
	CALL	CONV
	LD	DE,OUT_BUF
	LD	HL,0101H
	RST	30H
	DB	8
	DW	0075H
;
	LD	A,(0FEEBH)
	LD	BC,0FAD0H
	OUT	(C),A
	LD	E,A
	LD	A,64H
	SUB	E
	INC	C
	OUT	(C),A
;
	LD	HL,(0FEE9H)
	CALL	CONV
	LD	DE,OUT_BUF
	LD	HL,1001H
	RST	30H
	DB	8
	DW	0075H
;
	LD	A,(0FEE9H)
	LD	BC,0FAD2H
	OUT	(C),A
	LD	E,A
	LD	A,64H
	SUB	E
	INC	C
	OUT	(C),A
 ;
	RST	30H
	DB	8
	DW	00FCH
	JR	NC,LOOP
	RST	0
;
CONV:
;
;	SRL	H
;	RR	L
;	SRL	H
;	RR	L
;
CONV_DEC:	PUSH	HL
	LD	HL,OUT_BUF
	LD	(OUT_DEC),HL
	POP	HL
	LD	BC,0
	LD	(DECBUF),BC
	LD	(DECBUF+2),BC
	LD	C,10H
NEXTBIT:	ADD	HL,HL
	PUSH	HL
	LD	HL,DECBUF
	LD	B,4
NEXTDAA:	LD	A,(HL)
	ADC	A,A
	DAA
	LD	(HL),A
	INC	HL
	DJNZ	NEXTDAA
	POP	HL
	DEC	C
	JR	NZ,NEXTBIT
	LD	BC,0410H
	LD	HL,DECBUF+3
NEXTCHAR:	LD	A,(HL)
	RRA
	RRA
	RRA
AD053:	RRA
	CALL	OUT15
	LD	A,1
	SUB	B
	JR	NZ,NOLAST
	LD	C,A
NOLAST:	LD	A,(HL)
	DEC	HL
	CALL	OUT15
	DJNZ	NEXTCHAR
	RET
OUT15:	AND	0FH
	JR	Z,NULL
	LD	C,0
NULL:	OR	30H
	SUB	C
	PUSH	HL
	LD	HL,(OUT_DEC)
	LD	(HL),A
	INC	HL
	LD	(OUT_DEC),HL
	POP	HL
	RET


	.PHASE	4000H
DECBUF:	DS	4,0
OUT_DEC:DS	4,0
OUT_BUF:DS	8,0
	.DEPHASE
	END	START
